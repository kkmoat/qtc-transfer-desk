{
  "name": "qtc-transfer-desk",
  "version": "1.0.0",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "Browser-local Quantus QTC transfer desk with ML-DSA-65 signing",
  "author": "kkmoat",
  "repository": {
    "type": "git",
    "url": "https://github.com/kkmoat/qtc-transfer-desk.git"
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/verify-build.mjs",
    "preview": "node scripts/serve-static.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check:crypto": "node scripts/verify-crypto.mjs"
  },
  "dependencies": {
    "@polkadot/types": "16.5.6",
    "@polkadot/util-crypto": "14.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "radix-ui": "1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  },
  "type": "module"
}
