{
  "compilerOptions": {
    "target": "ES2022", "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true, "skipLibCheck": true, "strict": true, "noEmit": true,
    "esModuleInterop": true, "module": "esnext", "moduleResolution": "bundler",
    "resolveJsonModule": true, "isolatedModules": true, "jsx": "react-jsx",
    "paths": {"@/*": ["./*"]}, "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true
  },
  "include": ["app/**/*.tsx", "components/**/*.tsx", "src/**/*.tsx", "lib/**/*.ts", "tests/**/*.ts", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "crypto"]
}
